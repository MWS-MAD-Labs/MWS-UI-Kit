{
  "name": "mws-ui-kit",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/mws-ui-kit.umd.cjs",
  "module": "./dist/mws-ui-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mws-ui-kit.js",
      "require": "./dist/mws-ui-kit.umd.cjs"
    },
    "./style.css": "./dist/mws-ui-kit.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -b && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 -c apps/docs/.storybook",
    "storybook:build": "storybook build -c apps/docs/.storybook",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish --provenance",
    "docker:build": "docker build -t mws-ui-kit:latest .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "lucide-react": "latest"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "jsdom": "^29.1.1",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "storybook": "^10.4.6",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  }
}
